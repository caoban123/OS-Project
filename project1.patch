+uint64
+freemem(void)
+{
+    uint64 count = 0;
+    struct run *r;
+
+    acquire(&kmem.lock);
+
+    r = kmem.freelist;
+    while (r != 0) {
+        count++;
+        r = r->next;
+    }
+
+    release(&kmem.lock);
+
+    return count * PGSIZE;
+}
